---
interface Props {
  class?: string;
}

const { class: className = 'size-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="var(--accent)"></rect>
  <path
    d="M11 9.5v13h4.25a6.5 6.5 0 0 0 0-13z"
    stroke="var(--on-accent)"
    stroke-width="2.6"
    stroke-linejoin="round"
  ></path>
</svg>
