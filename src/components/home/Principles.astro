---
import SectionHead from '@/components/ui/SectionHead.astro';
import { sections } from '@/config/home';
import { principles } from '@/data/principles';
---

<section class="shell mt-24 sm:mt-32" aria-labelledby="principles-title">
  <SectionHead id="principles-title" eyebrow={sections.principles.eyebrow} title={sections.principles.title} />
  <ol class="mt-12 grid gap-x-10 gap-y-10 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-3">
    {principles.map((principle, index) => (
      <li class="reveal">
        <p class="serif text-3xl text-accent-ink" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-3 text-lg font-semibold">{principle.title}</h3>
        <p class="mt-2 text-body">{principle.text}</p>
      </li>
    ))}
  </ol>
</section>
