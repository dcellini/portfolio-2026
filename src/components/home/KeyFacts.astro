---
import { facts } from '@/config/home';
---

<section class="shell" aria-label="Key facts">
  <dl class="reveal grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3">
    {facts.map((fact) => (
      <div class="flex flex-col-reverse gap-2 bg-surface p-6 sm:p-8">
        <dt class="max-w-[24ch] text-[0.95rem] leading-snug text-muted">{fact.label}</dt>
        <dd class="text-section">{fact.value}</dd>
      </div>
    ))}
  </dl>
</section>
