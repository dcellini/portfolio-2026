---
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { sections } from '@/config/home';
import { getCaseStudies, projectHref } from '@/lib/work';

// Plain list of case studies. Phase 4 turns this into the in-page viewer.
const caseStudies = await getCaseStudies();
---

<section id="work" class="shell mt-24 sm:mt-32" aria-labelledby="work-title">
  <SectionHead id="work-title" eyebrow={sections.work.eyebrow} title={sections.work.title} />
  <ul class="mt-12 grid gap-4 md:grid-cols-2">
    {caseStudies.map((project) => (
      <li class="work-card reveal relative flex flex-col rounded-card border border-line bg-surface p-6 sm:p-8">
        <p class="text-sm text-muted">
          {project.data.dates} · {project.data.role}
        </p>
        <h3 class="mt-3 text-title">
          <a href={projectHref(project)} class="after:absolute after:inset-0 focus-visible:outline-none">
            {project.data.name}
          </a>
        </h3>
        <p class="mt-2 text-body">{project.data.title}</p>
        <p class="mt-6 flex items-baseline gap-3 border-t border-line pt-5">
          <span class="text-section leading-none whitespace-nowrap">{project.data.headline.value}</span>
          <span class="text-sm text-muted">{project.data.headline.label}</span>
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold" aria-hidden="true">
          Read the case study
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .work-card {
    transition: border-color 160ms ease;
  }

  .work-card:hover {
    border-color: var(--line-strong);
  }

  .work-card:has(a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
</style>
