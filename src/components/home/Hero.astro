---
import { Picture } from 'astro:assets';
import portrait from '@/assets/david-cellini.jpg';
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
import { siteConfig } from '@/config/site';
---

<section id="top" class="shell pt-10 pb-14 sm:pt-12 sm:pb-16 lg:pt-14" aria-labelledby="hero-title">
  <div class="hero-grid">
    {siteConfig.availability.enabled && (
      <p class="hero-badge rise inline-flex items-center gap-3 rounded-full border border-line bg-surface py-1.5 pr-4 pl-3 text-sm text-body shadow-[0_1px_2px_rgb(18_18_17/0.04)]">
        <span class="availability-dot" aria-hidden="true" />
        {siteConfig.availability.label}
      </p>
    )}

    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      alt="David Cellini, smiling, in a black T-shirt"
      widths={[176, 272, 408, 544, 816]}
      sizes="(min-width: 80rem) 17rem, (min-width: 64rem) 15rem, 11rem"
      pictureAttributes={{ class: 'portrait-frame' }}
      loading="eager"
      class="rise portrait"
      style="--rise-step: 3"
    />

    <div class="hero-text">
      <h1 id="hero-title" class="rise max-w-[22ch] text-headline" style="--rise-step: 1">
        {hero.title} <span class="serif">{hero.highlight}</span>
      </h1>

      <div class="rise mt-6" style="--rise-step: 2">
        <p class="max-w-xl text-lead text-body">{hero.text}</p>
        <p class="mt-3 max-w-xl font-medium text-ink">{hero.line}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={hero.primary.href}>
            {hero.primary.label}
            <Icon name="arrow-right" class="icon-nudge size-4" />
          </a>
          {siteConfig.resumePdf && (
            <a class="btn btn-ghost" href={siteConfig.resumePdf} download>
              <Icon name="download" class="size-4" />
              Download CV (PDF)
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .availability-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #22a55b;
  }

  /* Phones and tablets: photo and badge side by side, text full width below. */
  .hero-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'photo badge'
      'text text';
    align-items: center;
    gap: 1.5rem 1.25rem;
  }

  .hero-badge {
    grid-area: badge;
    justify-self: start;
  }

  .portrait-frame {
    grid-area: photo;
    width: 7rem;
    height: 7rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* Zoom in on the face, which would be tiny in a small circle. sizes="11rem" covers the zoom. */
  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.35);
    transform-origin: 50% 30%;
  }

  .hero-text {
    grid-area: text;
  }

  /* Desktop: badge and text on the left, the full portrait centred on the right. */
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      grid-template-areas:
        'badge photo'
        'text photo';
      column-gap: 3rem;
    }

    .hero-badge {
      align-self: end;
    }

    .hero-text {
      align-self: start;
    }

    .portrait-frame {
      width: 100%;
      height: auto;
      overflow: visible;
      border: 0;
      border-radius: 0;
    }

    .portrait {
      height: auto;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      transform: none;
    }
  }

  @media (min-width: 80rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .availability-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) 3; /* Stops after ~7s (WCAG 2.2.2). */
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
