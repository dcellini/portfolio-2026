---
import { Picture } from 'astro:assets';
import portrait from '@/assets/david-cellini.jpg';
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
import { siteConfig } from '@/config/site';
---

<section id="top" class="shell pt-10 pb-14 sm:pt-12 sm:pb-16 lg:pt-14" aria-labelledby="hero-title">
  <div class="hero-grid">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      alt="David Cellini, smiling, in a black T-shirt"
      widths={[176, 272, 408, 544, 816]}
      sizes="(min-width: 80rem) 17rem, (min-width: 64rem) 15rem, 11rem"
      pictureAttributes={{ class: 'portrait-frame' }}
      loading="eager"
      class="rise portrait"
    />

    <div class="hero-text">
      <h1 id="hero-title" class="rise max-w-[22ch] text-headline" style="--rise-step: 1">
        {hero.title} <span class="serif">{hero.highlight}</span>
      </h1>

      <div class="rise mt-6" style="--rise-step: 2">
        <p class="max-w-xl text-lead text-body">{hero.text}</p>
        <p class="mt-3 max-w-xl font-medium text-ink">{hero.line}</p>
        <div class="hero-actions mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={hero.primary.href}>
            {hero.primary.label}
            <Icon name="arrow-right" class="icon-nudge size-4" />
          </a>
          {siteConfig.resumePdf && (
            <a class="btn btn-ghost" href={siteConfig.resumePdf} download>
              <Icon name="download" class="size-4" />
              Download CV (PDF)
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Phones and tablets: a round photo, then everything centred below it. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .portrait-frame {
    justify-self: center;
    width: 8rem;
    height: 8rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* Zoom in on the face, which would be tiny in a small circle. sizes="11rem" covers the zoom. */
  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.35);
    transform-origin: 50% 30%;
  }

  .hero-text {
    text-align: center;
  }

  .hero-text h1,
  .hero-text p {
    margin-inline: auto;
  }

  .hero-actions {
    justify-content: center;
  }

  /* Desktop: text on the left, the full portrait centred beside it on the right. */
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: center;
      gap: 3rem;
    }

    .portrait-frame {
      order: 1;
      width: 100%;
      height: auto;
      overflow: visible;
      border: 0;
      border-radius: 0;
    }

    .portrait {
      height: auto;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      transform: none;
    }

    .hero-text {
      text-align: left;
    }

    .hero-text h1,
    .hero-text p {
      margin-inline: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }
  }

  @media (min-width: 80rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
  }
</style>
