---
import { Picture } from 'astro:assets';
import portrait from '@/assets/david-cellini.jpg';
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
import { siteConfig } from '@/config/site';
---

<section id="top" class="shell pt-10 pb-14 sm:pt-12 sm:pb-16 lg:pt-14" aria-labelledby="hero-title">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-center xl:grid-cols-[minmax(0,1fr)_17rem]">
    <div>
      {siteConfig.availability.enabled && (
        <p class="rise inline-flex items-center gap-3 rounded-full border border-line bg-surface py-1.5 pr-4 pl-3 text-sm text-body shadow-[0_1px_2px_rgb(18_18_17/0.04)]">
          <span class="availability-dot" aria-hidden="true" />
          {siteConfig.availability.label}
        </p>
      )}

      <h1 id="hero-title" class="rise mt-6 max-w-[22ch] text-headline" style="--rise-step: 1">
        {hero.title} <span class="serif">{hero.highlight}</span>
      </h1>

      <div class="rise mt-6" style="--rise-step: 2">
        <p class="max-w-xl text-lead text-body">{hero.text}</p>
        <p class="mt-3 max-w-xl font-medium text-ink">{hero.line}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={hero.primary.href}>
            {hero.primary.label}
            <Icon name="arrow-right" class="icon-nudge size-4" />
          </a>
          {siteConfig.resumePdf && (
            <a class="btn btn-ghost" href={siteConfig.resumePdf} download>
              <Icon name="download" class="size-4" />
              Download CV (PDF)
            </a>
          )}
        </div>
      </div>
    </div>

    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      alt="David Cellini, smiling, in a black T-shirt"
      widths={[272, 408, 544, 816]}
      sizes="(min-width: 80rem) 17rem, 15rem"
      loading="eager"
      class="rise portrait"
      style="--rise-step: 3"
    />
  </div>
</section>

<style>
  .availability-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #22a55b;
  }

  .portrait {
    width: 100%;
    max-width: 17rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }

  /* Phones and tablets keep the hero short; the photo shows from 1024px. */
  @media (max-width: 63.99rem) {
    .portrait {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .availability-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) 3; /* Stops after ~7s (WCAG 2.2.2). */
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
