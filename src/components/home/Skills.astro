---
import SectionHead from '@/components/ui/SectionHead.astro';
import { sections } from '@/config/home';
import { skills } from '@/data/skills';
import SkillChip from '@/components/ui/SkillChip.astro';
import SkillGroupIcon from '@/components/ui/SkillGroupIcon.astro';
---

<section id="skills" class="shell mt-24 sm:mt-32" aria-labelledby="skills-title">
  <SectionHead id="skills-title" eyebrow={sections.skills.eyebrow} title={sections.skills.title} />
  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {skills.map((group) => (
      <div class="skill-group reveal rounded-card border border-line bg-surface p-6 sm:p-8">
        <h3 class="flex items-center gap-3 font-semibold">
          <SkillGroupIcon name={group.icon} />
          {group.title}
        </h3>
        <ul class="mt-5 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <SkillChip name={item} />
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
