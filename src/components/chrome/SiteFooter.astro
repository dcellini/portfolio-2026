---
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { closing } from '@/config/home';
import { legalLinks, navigation, siteConfig } from '@/config/site';
import { socialIcon } from '@/lib/socials';

interface Props {
  closing?: boolean;
}

const { closing: showClosing = true } = Astro.props;
const { email } = siteConfig.author;
const year = new Date().getFullYear();
---

{showClosing && (
  <section id="contact" class="shell mt-24 sm:mt-32" aria-labelledby="closing-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-night px-6 py-14 text-night-ink sm:px-12 sm:py-20 lg:px-20 lg:py-24">
      <div class="closing-grid" aria-hidden="true" />
      <div class="relative">
        <p class="eyebrow text-night-muted">{closing.eyebrow}</p>
        <h2 id="closing-title" class="mt-6 max-w-[18ch] text-headline">
          {closing.title && `${closing.title} `}
          <span class="serif text-night-accent">{closing.highlight}</span>
        </h2>
        <p class="mt-6 max-w-xl text-lead text-night-muted">{closing.text}</p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a class="btn btn-accent" href={`mailto:${email}`}>
            <Icon name="mail" class="size-4" />
            {email}
          </a>
          <button type="button" class="btn night-ghost copy-email" data-copy-email={email} data-needs-js>
            <span class="copy-idle inline-flex items-center gap-2">
              <Icon name="copy" class="size-4" />
              Copy address
            </span>
            <span class="copy-done items-center gap-2" hidden>
              <Icon name="check" class="size-4" />
              Copied
            </span>
          </button>
          <span class="sr-only" role="status" data-copy-status></span>
          {siteConfig.socials.map((social) => (
            <a class="btn night-ghost" href={social.href} rel="me noopener">
              <Icon name={socialIcon(social.label)} class="size-4" />
              {social.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<footer class="mt-24 border-t border-line sm:mt-32">
  <div class="shell grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 text-[1.15rem] font-semibold tracking-[-0.03em]">
        <Logomark />
        <span>{siteConfig.name}</span>
        <span class="sr-only">, home</span>
      </a>
      <p class="mt-5 max-w-xs text-muted">
        {siteConfig.author.role} based in {siteConfig.author.location}.
      </p>
    </div>

    <nav aria-labelledby="footer-pages">
      <h2 id="footer-pages" class="text-sm font-medium text-muted">
        Pages
      </h2>
      <ul class="mt-4 grid gap-2.5">
        <li>
          <a class="footer-link" href="/">
            Home
          </a>
        </li>
        {navigation.map((link) => (
          <li>
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="text-sm font-medium text-muted">
        Elsewhere
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-link inline-flex items-center gap-2.5" href={social.href} rel="me noopener">
              <Icon name={socialIcon(social.label)} class="size-3.5 text-muted" />
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="text-sm font-medium text-muted">
        Legal
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {legalLinks.map((link) => (
          <li>
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="shell flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-muted">
    <p>
      &copy; {year} {siteConfig.author.name}. Built with{' '}
      <a class="link text-muted hover:text-ink" href="https://astro.build/" rel="noopener">
        Astro
      </a>{' '}
      on the{' '}
      <a class="link text-muted hover:text-ink" href="https://github.com/xocothemes/maria" rel="noopener">
        Maria theme
      </a>{' '}
      by Andrei Alba.
    </p>
    <a href="#content" class="inline-flex items-center gap-1.5 hover:text-ink">
      Back to top
      <Icon name="arrow-up" class="size-3.5" />
    </a>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--ink);
    transition: color 160ms ease;
  }

  .footer-link:hover {
    color: var(--muted);
  }

  .night-ghost {
    border-color: color-mix(in oklab, var(--night-ink) 30%, transparent);
    color: var(--night-ink);
  }

  .night-ghost:hover {
    border-color: var(--night-ink);
  }

  .copy-email {
    min-width: 10.5rem;
  }

  .copy-done:not([hidden]) {
    display: inline-flex;
    color: var(--night-accent);
  }

  .closing-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.09) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 90% at 100% 100%, #000 10%, transparent 70%);
  }
</style>

<script>
  // Copies the email address and shows a tick for a moment. It can be clicked again at any time.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    const idle = button.querySelector<HTMLElement>('.copy-idle')!;
    const done = button.querySelector<HTMLElement>('.copy-done')!;
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    let timer: number | undefined;

    const copy = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback for browsers or contexts without the async clipboard API.
        const field = Object.assign(document.createElement('textarea'), { value: text });
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.append(field);
        field.select();
        const ok = document.execCommand('copy');
        field.remove();
        return ok;
      }
    };

    button.addEventListener('click', async () => {
      const ok = await copy(button.dataset.copyEmail!);
      if (status) status.textContent = '';
      if (!ok) {
        if (status) status.textContent = 'Copying failed. The address is ' + button.dataset.copyEmail;
        return;
      }
      idle.hidden = true;
      done.hidden = false;
      // Clear then set, so screen readers announce it on every click.
      requestAnimationFrame(() => {
        if (status) status.textContent = 'Email address copied';
      });
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        idle.hidden = false;
        done.hidden = true;
      }, 2000);
    });
  });
</script>
