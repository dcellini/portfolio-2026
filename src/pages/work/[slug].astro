---
import { render } from 'astro:content';
import { mdxComponents } from '@/components/mdx';
import Icon from '@/components/ui/Icon.astro';
import NextProject from '@/components/work/NextProject.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { caseStudySchema } from '@/lib/schema';
import { attribution, getProjects, getQuotes, type Project } from '@/lib/work';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => {
    // "Next" stays within the same kind: case study to case study, short page to short page.
    const siblings = projects.filter((p) => p.data.kind === project.data.kind);
    const next = siblings[(siblings.indexOf(project) + 1) % siblings.length];
    return { params: { slug: project.id }, props: { project, next } };
  });
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const quotes = await getQuotes(project);

const meta = [
  { label: 'Dates', value: data.dates },
  data.role && { label: 'Role', value: data.role },
  data.kind === 'full' && data.scope && { label: 'Scope', value: data.scope },
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<BaseLayout title={data.name} description={data.summary} type="article" structuredData={caseStudySchema(project)}>
  <article>
    <header class="shell pt-12 sm:pt-16">
      <a class="rise flex w-fit items-center gap-2 text-sm text-muted hover:text-ink" href="/#work">
        <Icon name="arrow-left" class="size-3.5" />
        All case studies
      </a>
      <p class="rise eyebrow mt-8 flex w-fit">{data.name}</p>
      <h1 class="rise mt-6 max-w-[22ch] text-headline" style="--rise-step: 1">
        {data.title}
      </h1>
      <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
        {data.summary}
      </p>

      <dl
        class="rise mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-8 sm:grid-cols-3 lg:flex lg:gap-14"
        style="--rise-step: 3"
      >
        {meta.map((item) => (
          <div>
            <dt class="text-sm text-muted">{item.label}</dt>
            <dd class="mt-1 font-medium">{item.value}</dd>
          </div>
        ))}
      </dl>

      {data.stack.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tech stack">
          {data.stack.map((item) => (
            <li class="chip">{item}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="shell mt-16 sm:mt-24">
      <div class="prose case-prose">
        <Content components={mdxComponents} />

        {data.kind === 'full' && (
          <>
            <h2>How it works</h2>
            <ol>
              {data.diagram.map((step) => (
                <li>{step}</li>
              ))}
            </ol>

            <h2>The result</h2>
            <p>
              <strong>{data.headline.value}</strong> {data.headline.label}
            </p>
            {data.result.map((line) => (
              <p>{line}</p>
            ))}
          </>
        )}

        {quotes.length > 0 && (
          <>
            <h2>What colleagues said</h2>
            {quotes.map((quote) => (
              <figure>
                <blockquote>
                  <p>{quote.data.text}</p>
                </blockquote>
                <figcaption class="text-[0.95rem] text-muted">{attribution(quote)}</figcaption>
              </figure>
            ))}
          </>
        )}
      </div>
    </div>
  </article>

  {next.id !== project.id && <NextProject project={next} />}
</BaseLayout>

<style>
  .case-prose > :global(*) {
    margin-inline: auto;
  }

  .case-prose > :global(*:first-child) {
    margin-top: 0;
  }

  .case-prose figure blockquote {
    margin-block: 2.5em 0.75em;
  }
</style>
