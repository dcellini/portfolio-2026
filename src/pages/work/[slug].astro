---
import { render } from 'astro:content';
import { mdxComponents } from '@/components/mdx';
import Icon from '@/components/ui/Icon.astro';
import SkillChip from '@/components/ui/SkillChip.astro';
import NextProject from '@/components/work/NextProject.astro';
import StepDiagram from '@/components/work/StepDiagram.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { caseStudySchema } from '@/lib/schema';
import { attribution, getProjects, getQuotes, type Project } from '@/lib/work';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => {
    // "Next" stays within the same kind: case study to case study, short page to short page.
    const siblings = projects.filter((p) => p.data.kind === project.data.kind);
    const next = siblings[(siblings.indexOf(project) + 1) % siblings.length];
    return { params: { slug: project.id }, props: { project, next } };
  });
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const quotes = await getQuotes(project);

// Back to this case study in the homepage viewer, or to the More work cards.
const back =
  data.kind === 'full'
    ? { href: `/?case=${project.id}`, label: 'All case studies' }
    : { href: '/#more-work', label: 'All work' };

const meta = [
  { label: 'Dates', value: data.dates },
  data.role && { label: 'Role', value: data.role },
  data.kind === 'full' && data.scope && { label: 'Scope', value: data.scope },
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<BaseLayout
  title={data.kind === 'full' ? `${data.name} case study` : data.name}
  description={data.summary}
  type="article"
  structuredData={caseStudySchema(project)}
>
  <article>
    <header class="shell pt-12 sm:pt-16">
      <a class="rise flex w-fit items-center gap-2 text-sm text-muted hover:text-ink" href={back.href}>
        <Icon name="arrow-left" class="size-3.5" />
        {back.label}
      </a>
      <p class="rise eyebrow mt-10 flex w-fit">{data.name}</p>
      <h1 class="rise mt-6 max-w-[22ch] text-headline" style="--rise-step: 1">
        {data.title}
      </h1>
      <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
        {data.summary}
      </p>

      <div class="rise mt-12 border-t border-line pt-8" style="--rise-step: 3">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 lg:flex lg:gap-14">
          {meta.map((item) => (
            <div>
              <dt class="text-sm text-muted">{item.label}</dt>
              <dd class="mt-1 font-medium">{item.value}</dd>
            </div>
          ))}
        </dl>
        {data.stack.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tech stack">
            {data.stack.map((item) => (
              <SkillChip name={item} />
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="shell mt-16 sm:mt-20">
      <div class="prose case-prose">
        <Content components={mdxComponents} />

        {data.kind === 'full' && (
          <>
            <h2>How it works</h2>
            <div class="not-prose">
              <StepDiagram steps={data.diagram} label={`How ${data.name} works`} stacked />
            </div>

            <h2>The result</h2>
            <div class="not-prose headline-figure">
              <p class="text-display leading-none text-accent-ink">{data.headline.value}</p>
              <p class="mt-3 max-w-md text-lead text-muted">{data.headline.label}</p>
            </div>
            {data.result.length > 1 ? (
              <ul>
                {data.result.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            ) : (
              <p>{data.result[0]}</p>
            )}
          </>
        )}

        {quotes.length > 0 && (
          <>
            <h2>What colleagues said</h2>
            {quotes.map((quote) => (
              <figure class="case-quote">
                <blockquote>
                  <p>{quote.data.text}</p>
                </blockquote>
                <figcaption>{attribution(quote)}</figcaption>
              </figure>
            ))}
          </>
        )}
      </div>
    </div>
  </article>

  {next.id !== project.id && <NextProject project={next} />}
</BaseLayout>

<style>
  .case-prose > :global(*) {
    margin-inline: auto;
  }

  .case-prose > :global(*:first-child) {
    margin-top: 0;
  }

  .case-prose > .not-prose {
    max-width: 44rem;
  }

  .headline-figure {
    padding: 1.75rem 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .case-quote {
    max-width: 44rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--accent);
  }

  .case-quote blockquote {
    margin-block: 0;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem);
  }

  .case-quote figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
